@baseUrl = http://localhost:3000
@missingProductId = 000000000000000000000000
@invalidProductId = not-an-object-id

### Health check
# Expected: 200
GET {{baseUrl}}/health
Accept: application/json

### Admin login
# Set ADMIN_EMAIL and ADMIN_PASSWORD in .env before running this request.
# Expected: 200
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}",
  "password": "{{$dotenv ADMIN_PASSWORD}}"
}

### Save the admin token
@adminToken = {{adminLogin.response.body.$.token}}

### Regular user login
# Expected: 200
# @name userLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{$dotenv USER_EMAIL}}",
  "password": "{{$dotenv USER_PASSWORD}}"
}

### Save the regular user token
@userToken = {{userLogin.response.body.$.token}}

### Login with a missing password
# Expected: 400
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}"
}

### Login with the wrong password
# Expected: 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}",
  "password": "wrong-password"
}

### Login with an invalid body shape
# Expected: 400
POST {{baseUrl}}/auth/login
Content-Type: application/json

[]

### Create a product without authentication
# Expected: 401
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Unauthenticated Product",
  "price": 10,
  "quantity": 1
}

### Create a product as a regular user
# Expected: 403
POST {{baseUrl}}/products
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "name": "Unauthorized Product",
  "price": 10,
  "quantity": 1
}

### Create a product with invalid fields as an admin
# Expected: 400
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "",
  "category": 42,
  "price": -1,
  "quantity": 1.5
}

### Create a product as an admin
# Expected: 201
# @name createProduct
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "REST Client Demo Product",
  "category": "Electronics",
  "price": 99.99,
  "quantity": 10
}

### Save the created product ID
@createdProductId = {{createProduct.response.body.$.data._id}}

### Get the created product
# Expected: 200
GET {{baseUrl}}/products/{{createdProductId}}
Accept: application/json

### Update the created product without authentication
# Expected: 401
PUT {{baseUrl}}/products/{{createdProductId}}
Content-Type: application/json

{
  "name": "Unauthenticated Update",
  "price": 20,
  "quantity": 2
}

### Update the created product as a regular user
# Expected: 403
PUT {{baseUrl}}/products/{{createdProductId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "name": "Unauthorized Update",
  "price": 20,
  "quantity": 2
}

### Update the created product with invalid fields as an admin
# Expected: 400
PUT {{baseUrl}}/products/{{createdProductId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "",
  "category": 42,
  "price": 0,
  "quantity": -1
}

### Update the created product as an admin
# Expected: 200
PUT {{baseUrl}}/products/{{createdProductId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Updated REST Client Demo Product",
  "category": "Electronics",
  "price": 109.99,
  "quantity": 8
}

### List products with the default page
# Expected: 200
GET {{baseUrl}}/products
Accept: application/json

### List products, page 1
# Expected: 200
# @name productList
GET {{baseUrl}}/products?page=1
Accept: application/json

### Save the first listed product ID
@listedProductId = {{productList.response.body.$.data[0]._id}}

### List products, page 2
# Expected: 200
GET {{baseUrl}}/products?page=2
Accept: application/json

### List an empty page
# Expected: 200 with an empty data array
GET {{baseUrl}}/products?page=999999
Accept: application/json

### List products with an invalid page
# Expected: 400
GET {{baseUrl}}/products?page=0
Accept: application/json

### Get the first listed product
# Expected: 200
GET {{baseUrl}}/products/{{listedProductId}}
Accept: application/json

### Get a missing product
# Expected: 404
GET {{baseUrl}}/products/{{missingProductId}}
Accept: application/json

### Get a product with a malformed ID
# Expected: 400
GET {{baseUrl}}/products/{{invalidProductId}}
Accept: application/json

### Update a missing product
# Expected: 404
PUT {{baseUrl}}/products/{{missingProductId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Missing Product",
  "price": 25,
  "quantity": 1
}

### Update a product with a malformed ID
# Expected: 400
PUT {{baseUrl}}/products/{{invalidProductId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Malformed ID Product",
  "price": 25,
  "quantity": 1
}

### Delete the created product without authentication
# Expected: 401
DELETE {{baseUrl}}/products/{{createdProductId}}

### Delete the created product as a regular user
# Expected: 403
DELETE {{baseUrl}}/products/{{createdProductId}}
Authorization: Bearer {{userToken}}

### Delete the created product as an admin
# Expected: 204
DELETE {{baseUrl}}/products/{{createdProductId}}
Authorization: Bearer {{adminToken}}

### Confirm the deleted product is no longer available
# Expected: 404
GET {{baseUrl}}/products/{{createdProductId}}
Accept: application/json

### Delete a missing product
# Expected: 404
DELETE {{baseUrl}}/products/{{missingProductId}}
Authorization: Bearer {{adminToken}}

### Delete a product with a malformed ID
# Expected: 400
DELETE {{baseUrl}}/products/{{invalidProductId}}
Authorization: Bearer {{adminToken}}

### Unknown route
# Expected: 404
GET {{baseUrl}}/does-not-exist
Accept: application/json
